# =============================================================
# SOET Connect Backend — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# --- Database Backend ---
# Supported: "supabase" (Supabase PostgreSQL via PostgREST)
DATABASE_BACKEND=supabase

# --- Database Mode ---
# Options:
#   "supabase" (or unset) -> Connects to remote Supabase PostgreSQL
#   "mock"                -> In-memory tables for local unit tests
DATABASE_MODE=supabase

# --- Supabase Configuration ---
# Required for Supabase PostgreSQL persistence
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- JWT Authentication ---
# Required in production mode. Must be a strong, random 32+ character secret.
# Must NEVER have a hard-coded fallback in production.
JWT_SECRET_KEY=your-secure-jwt-secret-key-at-least-32-chars

# Optional: JWT signing algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Optional: Admin registration secret
ADMIN_REGISTRATION_SECRET=your-admin-registration-secret

# --- Email Notification Delivery (Resend - Optional) ---
# When omitted, email delivery is marked as skipped while in-app notifications continue working.
# NOTE: The sender domain in RESEND_FROM_EMAIL MUST be added and verified with DKIM/SPF
# records in your Resend dashboard (https://resend.com/domains). Unverified domains will fail.
# For initial testing before domain verification, use 'onboarding@resend.dev' (can only deliver to your Resend account email).
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=notifications@soetconnect.edu

# --- SMS Notification Delivery (Twilio - Optional) ---
# When omitted, SMS delivery is marked as skipped while in-app notifications continue working.
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# --- Public Application URL ---
PUBLIC_APP_URL=https://soet-connect.vercel.app

# --- Password Reset Secret Key (Optional) ---
# Defaults to JWT_SECRET_KEY if not explicitly configured.
PASSWORD_RESET_SECRET_KEY=your-secure-password-reset-secret-key-at-least-32-chars

