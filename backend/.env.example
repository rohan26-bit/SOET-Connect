# =============================================================
# SOET Connect Backend — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# --- Database Mode ---
# Options:
#   "atlas" (or unset) -> Connects to real MongoDB Atlas (requires MONGODB_URL + DATABASE_NAME)
#   "mock"             -> In-memory mongomock (for local pytest and offline dev)
DATABASE_MODE=atlas

# --- MongoDB Atlas Connection ---
# Required in production / atlas mode.
# Accepts MONGODB_URL or MONGODB_URI alias.
# Must NEVER have a hard-coded fallback in production.
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/
# Alias: MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/

# Required in production / atlas mode.
# Accepts DATABASE_NAME or MONGODB_DATABASE alias.
DATABASE_NAME=soet_connect
# Alias: MONGODB_DATABASE=soet_connect

# Optional: MongoDB server selection timeout in milliseconds (default: 5000)
# MONGODB_TIMEOUT_MS=5000

# --- JWT Authentication ---
# Required in production mode. Must be a strong, random 32+ character secret.
# Must NEVER have a hard-coded fallback in production.
# In DATABASE_MODE=mock, an explicit test-only fallback is permitted for pytest.
JWT_SECRET_KEY=your-secure-jwt-secret-key-at-least-32-chars

# Optional: JWT signing algorithm (default: HS256)
JWT_ALGORITHM=HS256
